# Byte-pinned W4 evidence must remain LF on every checkout, including
# core.autocrlf=true worktrees.  These inputs are hashed by permanent tests.
/RT2App/assets/rr-guide-controlled.rt2scene text eol=lf
/RT2App/shaders/secondary_raygen.rgen text eol=lf
/docs/rr-guide-report-*.json text eol=lf
/docs/agx-minimal-wrensch-source.glsl text eol=lf
# Audio A1: byte-pinned upstream miniaudio (SHA256 in
# RT2AudioBackend/VENDORING.md, enforced by run_audio_a1_gates.ps1). Any
# CRLF conversion would break byte identity, so force LF end to end.
/RT2AudioBackend/vendor/miniaudio/miniaudio.h text eol=lf
/RT2AudioBackend/vendor/miniaudio/miniaudio.c text eol=lf
/RT2AudioBackend/vendor/miniaudio/LICENSE text eol=lf
# Audio A4: decoder fixtures are byte-exact oracle inputs. Any EOL
# conversion would corrupt them and change content fingerprints, so they
# are binary end to end (this also keeps the ASCII corrupt fixture out of
# `git diff --check`).
/RT2AudioProbe/fixtures/*.wav binary
/RT2AudioProbe/fixtures/*.flac binary
/RT2AudioProbe/fixtures/*.mp3 binary
/RT2AudioProbe/fixtures/*.bin binary
# Audio A8: acceptance clips are byte-identical copies of generated probe
# fixtures. Binary end to end so content fingerprints stay stable.
/RT2App/assets/audio/*.wav binary
