# Simple unit cube centered at origin, ±0.5 on each axis
# Winding: counter-clockwise when viewed from outside (right-handed)

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# -Z face (front)
f 1 2 3
f 1 3 4
# +Z face (back)
f 5 6 7
f 5 7 8
# -X face (left)
f 1 4 8
f 1 8 5
# +X face (right)
f 2 3 7
f 2 7 6
# -Y face (bottom)
f 1 2 6
f 1 6 5
# +Y face (top)
f 4 3 7
f 4 7 8