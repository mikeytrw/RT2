#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

#include "shader_interface.h"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;

// G-buffer inputs (same bindings as set 1)
layout(set = 1, binding = 0, rgb10_a2) uniform readonly image2D gNormalRoughness;
layout(set = 1, binding = 1, r32f)  uniform readonly image2D gViewZ;
layout(set = 1, binding = 2, rg16f) uniform readonly image2D gMotion;
layout(set = 1, binding = 5, rgba16f) uniform readonly image2D gAlbedoF0;
layout(set = 1, binding = 7, rgba16f) uniform readonly image2D gDirectEmission;
layout(set = 1, binding = 8, rgba32f) uniform readonly image2D gPrimHit;
layout(set = 1, binding = 9, rgba8)  uniform readonly image2D gPrimGeoNormal;
layout(set = 1, binding = 10, rg16f) uniform readonly image2D gPrimUV;
layout(set = 1, binding = SI_BINDING_G_DIFF_RADIANCE, rgba16f) uniform readonly image2D gDiffRadianceHitDist;
layout(set = 1, binding = SI_BINDING_G_SPEC_RADIANCE, rgba16f) uniform readonly image2D gSpecRadianceHitDist;

// Reservoir buffer (set 0, binding 14) — shared with PathTracePass set 0 layout
// restir_shared.glsl needs bindings + helpers that gbuffer_debug doesn't have.
// Declare minimal stubs so the include compiles; only struct/accessors are used.
struct TriangleLight { vec4 emission_area; uvec4 ids; };
layout(set = 0, binding = SI_BINDING_LIGHT_BUFFER, std430) readonly buffer LightBuffer
{ uint lightCount; float totalLightArea; uint _p0; uint _p1; TriangleLight lights[]; };
layout(set = 0, binding = SI_BINDING_INSTANCE_MESH_INFO, std430) readonly buffer InstanceMeshInfo
{ uvec4 instanceMeshInfo[]; };
layout(set = 0, binding = SI_BINDING_INDEX_BUFFER, std430) readonly buffer IndexBuffer
{ uint indices[]; };
layout(set = 0, binding = SI_BINDING_VERTEX_BUFFER, std430) readonly buffer VertexBuffer
{ vec4 vertices[]; };
layout(set = 0, binding = SI_BINDING_UV_BUFFER, std430) readonly buffer UVBuffer
{ vec4 uvs[]; };
layout(set = 0, binding = SI_BINDING_INSTANCE_TRANSFORMS, std430) readonly buffer InstanceTransforms
{ mat4 instanceTransforms[]; };
layout(set = 0, binding = SI_BINDING_TEXTURE_ARRAY) uniform sampler2D textures[];
layout(set = 0, binding = SI_BINDING_CAMERA_UBO, std140) uniform CameraData
{ vec4 position; vec4 forward; vec4 right; vec4 up; vec4 viewportSPP; vec4 apertureFocal;
  vec4 envMap; mat4 inverseProjection; mat4 inverseView; mat4 viewToClip; mat4 viewToClipPrev;
  mat4 worldToView; mat4 worldToViewPrev; } camera;

// NRD UBO — for GI debug views (restirGIReservoirIndex).
layout(set = 1, binding = SI_BINDING_NRD_UBO) uniform NRDUniformDebug
{
    uint nrdEnabledDebug;
    uint lobeDitherDebug;
    uint restirGIEnabledDebug;
    uint restirGIReservoirIndexDebug;
} nrdDebugData;
struct Material { vec4 baseColor_metallic; vec4 emissive_roughness; float ior;
  float alphaCutoff; float alphaMode; float baseAlpha; ivec4 textureIndices; ivec4 extraIndices; };
layout(set = 0, binding = SI_BINDING_MATERIAL_BUFFER, std430) readonly buffer MaterialBuffer
{ Material materials[]; };
float randomFloat(inout uint s) { return 0.0; }
float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3 evalDiffuseBRDF(vec3 wo, vec3 wi, vec3 n, vec3 bc, float m) { return vec3(0.0); }
float computePTri() { return 0.0; }
vec2 directionToEnvUV(vec3 d) { return vec2(0.0); }
vec3 envUVToDirection(vec2 uv) { return vec3(0.0); }
vec3 envMapRadiance(vec3 d) { return vec3(0.0); }
float envMapPdf(vec3 d) { return 0.0; }
#define PI 3.14159265359

#include "restir_shared.glsl"
layout(set = 0, binding = SI_BINDING_RESERVOIR_HISTORY, std430) readonly buffer ReservoirBuffer
{
    Reservoir reservoirs[];
};

// ---- GI reservoir buffer (set 0, binding 11) — for GI debug views ----
#include "surface_history_shared.glsl"
#include "restir_gi_shared.glsl"
layout(set = 0, binding = SI_BINDING_GI_DATA, std430) readonly buffer GIDebugDataBuffer
{
    uvec4 giDebugData[];
};

const uint GI_RESERVOIR_BYTES_DBG = 48u;

GIReservoir loadGIDebugReservoir(uint region, uint pixelLinear, uint pixelCount)
{
    uint byteOffset = region * pixelCount * GI_RESERVOIR_BYTES_DBG
                    + pixelLinear * GI_RESERVOIR_BYTES_DBG;
    uint wordOffset = byteOffset / 16u;
    GIReservoir r;
    r.data0 = giDebugData[wordOffset + 0u];
    r.data1 = giDebugData[wordOffset + 1u];
    r.data2 = giDebugData[wordOffset + 2u];
    return r;
}

layout(push_constant) uniform Push {
    uint mode;
} pc;

// NRD oct-decode (ported from NRD.hlsli)
vec4 nrdDecodeNormalRoughness(vec3 p)
{
    float t = p.z * 2.0 - 1.0;
    vec4 r;
    r.x = p.x - p.y;
    r.y = p.x + p.y - 1.0;
    r.z = t < 0.0 ? -1.0 : 1.0;
    r.z *= 1.0 - abs(r.x) - abs(r.y);
    r.w = abs(t);
    r.xyz = normalize(r.xyz);
    r.w = clamp(r.w, 0.0, 1.0); // NRD_ROUGHNESS_ENCODING=1 (LINEAR)
    return r;
}

vec3 debugYCoCgToLinear(vec3 ycocg)
{
    float t = ycocg.x - ycocg.z;
    return max(vec3(t + ycocg.y, ycocg.x + ycocg.z, t - ycocg.y), vec3(0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 color = vec3(0.0);

    if (pc.mode >= 100) {
        // Self-test: constant color output
        color = vec3(1.0, 0.5, 0.2);
        imageStore(outputImage, pixel, vec4(color, 1.0));
        return;
    }

    switch (pc.mode)
    {
        case 0: { // shading normal (oct-packed, decode + visualize)
            vec4 nr = imageLoad(gNormalRoughness, pixel);
            vec4 decoded = nrdDecodeNormalRoughness(nr.xyz);
            color = decoded.xyz * 0.5 + 0.5;
            break;
        }
        case 1: { // roughness (decoded from oct-packed LINEAR)
            vec4 nr = imageLoad(gNormalRoughness, pixel);
            vec4 decoded = nrdDecodeNormalRoughness(nr.xyz);
            color = vec3(decoded.w);
            break;
        }
        case 2: { // viewZ (depth, inverted)
            float z = imageLoad(gViewZ, pixel).x;
            color = vec3(clamp(-z * 0.02, 0.0, 1.0));
            break;
        }
        case 3: { // motion vectors
            vec2 m = imageLoad(gMotion, pixel).xy;
            color = vec3(abs(m) * 20.0, 0.0);
            break;
        }
        case 4: { // albedo
            color = imageLoad(gAlbedoF0, pixel).rgb;
            break;
        }
        case 5: { // F0
            color = vec3(imageLoad(gAlbedoF0, pixel).a);
            break;
        }
        case 6: { // direct emission
            color = imageLoad(gDirectEmission, pixel).rgb;
            break;
        }
        case 7: { // world position
            vec3 p = imageLoad(gPrimHit, pixel).xyz;
            color = p * 0.1;
            break;
        }
        case 8: { // geometric normal (decoded)
            vec4 n = imageLoad(gPrimGeoNormal, pixel);
            color = n.xyz * 2.0 - 1.0;
            color = color * 0.5 + 0.5;
            break;
        }
        case 9: { // UV
            color = vec3(imageLoad(gPrimUV, pixel).xy, 0.0);
            break;
        }
        case 10: { // material index (numeric +1 sentinel in gPrimHit.w)
            float matIdx = imageLoad(gPrimHit, pixel).w - 1.0;
            color = vec3(fract(matIdx * 0.1), fract(matIdx * 0.3), fract(matIdx * 0.7));
            break;
        }
        case 11: { // ReSTIR reservoir visualization
            // Red = has valid reservoir, Green = targetPdf intensity,
            // Blue = weightSum intensity. Sky/emissive = black.
            uint w = uint(size.x);
            Reservoir res = reservoirs[pixel.y * w + pixel.x];
            res = sanitizeReservoir(res);
            if (reservoirValid(res) && reservoirTargetPdf(res) > 0.0)
            {
                color.r = 1.0;
                color.g = clamp(log(reservoirTargetPdf(res) + 1.0) * 0.1, 0.0, 1.0);
                color.b = clamp(log(reservoirWeightSum(res) + 1.0) * 0.02, 0.0, 1.0);
            }
            else
            {
                color = vec3(0.0);
            }
            break;
        }
        case 12: { // GI direction (selected direction → RGB)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            r = sanitizeGIReservoir(r);
            if (giValid(r))
                color = giDirection(r) * 0.5 + 0.5;
            break;
        }
        case 13: { // GI Lo (stored outgoing radiance)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            r = sanitizeGIReservoir(r);
            if (giValid(r))
                color = giLo(r);
            color = clamp(color * 0.1, 0.0, 1.0);
            break;
        }
        case 14: { // GI hitT (selected direction hit distance)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            r = sanitizeGIReservoir(r);
            if (giValid(r))
                color = vec3(clamp(giHitT(r) * 0.02, 0.0, 1.0));
            break;
        }
        case 15: { // GI M/Age (R = M, G = age)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            r = sanitizeGIReservoir(r);
            if (giValid(r))
            {
                color.r = clamp(float(giM(r)) / 10.0, 0.0, 1.0);
                color.g = clamp(float(giAge(r)) / 8.0, 0.0, 1.0);
            }
            break;
        }
        case 16: { // GI fresh vs history (R = fresh, G = history)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            r = sanitizeGIReservoir(r);
            if (giValid(r))
            {
                if ((giFlags(r) & GI_FLAG_HISTORY) != 0u)
                    color.g = 1.0;  // history-derived
                else
                    color.r = 1.0;  // fresh
            }
            break;
        }
        case 17: { // GI reservoir validity (R = valid, G = env miss, B = geometry hit)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            if (giValid(r))
            {
                color.r = 1.0;
                if ((giFlags(r) & GI_FLAG_ENV_MISS) != 0u)
                    color.g = 1.0;
                if ((giFlags(r) & GI_FLAG_GEOMETRY_HIT) != 0u)
                    color.b = 1.0;
            }
            break;
        }
        case 18: { // GI weight W (R = W intensity, G = targetPdf, B = weightSum)
            uint w = uint(size.x);
            uint h = uint(size.y);
            uint pl = pixel.y * w + pixel.x;
            uint region = nrdDebugData.restirGIReservoirIndexDebug;
            GIReservoir r = loadGIDebugReservoir(region, pl, w * h);
            r = sanitizeGIReservoir(r);
            if (giValid(r))
            {
                float W = giReservoirW(r);
                color.r = clamp(log(W + 1.0) * 0.1, 0.0, 1.0);
                color.g = clamp(log(giTargetPdf(r) + 1.0) * 0.1, 0.0, 1.0);
                color.b = clamp(log(giWeightSum(r) + 1.0) * 0.02, 0.0, 1.0);
            }
            break;
        }
        case 19: { // packed NRD diffuse input, decoded and compressed for display
            vec3 radiance = debugYCoCgToLinear(imageLoad(gDiffRadianceHitDist, pixel).rgb);
            color = radiance / (vec3(1.0) + radiance);
            break;
        }
        case 20: { // packed NRD specular input, decoded and compressed for display
            vec3 radiance = debugYCoCgToLinear(imageLoad(gSpecRadianceHitDist, pixel).rgb);
            color = radiance / (vec3(1.0) + radiance);
            break;
        }
        case 21: { // ReSTIR DI normalization weight W
            uint w = uint(size.x);
            Reservoir res = sanitizeReservoir(reservoirs[pixel.y * w + pixel.x]);
            if (reservoirValid(res))
                color = vec3(clamp(log2(1.0 + reservoirW(res)) / 16.0, 0.0, 1.0));
            break;
        }
    }

    imageStore(outputImage, pixel, vec4(color, 1.0));
}
