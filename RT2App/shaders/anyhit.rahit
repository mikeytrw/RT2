#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_NV_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

#include "pathtracer_shared.glsl"
#include "material_resolve.glsl"

// Any-hit shader for alpha-blended/cutout materials (primary + BSDF rays).
// Reads base color texture alpha and uses Russian roulette (BLEND) or
// hard cutoff (MASK) to decide pass/absorb.
// Accept = return (do nothing). Reject = ignoreIntersectionNV().
layout(location = 0) rayPayloadInEXT RayPayload payload;

// Hardware-provided barycentric hit attributes (core GL_EXT_ray_tracing).
hitAttributeEXT vec2 attribs;

vec2 anyHitUV()
{
    uvec4 meshInfo = instanceMeshInfo[gl_InstanceID];
    uint idxBase = meshInfo.y + uint(gl_PrimitiveID) * 3u;
    uint i0 = indices[idxBase + 0u];
    uint i1 = indices[idxBase + 1u];
    uint i2 = indices[idxBase + 2u];

    vec2 uv0 = uvs[meshInfo.w + i0].xy;
    vec2 uv1 = uvs[meshInfo.w + i1].xy;
    vec2 uv2 = uvs[meshInfo.w + i2].xy;

    float u = 1.0 - attribs.x - attribs.y;
    return u * uv0 + attribs.x * uv1 + attribs.y * uv2;
}

void main()
{
    uint matIdx = resolveMaterialIndex(gl_InstanceID, uint(gl_PrimitiveID));
    Material mat = materials[matIdx];

    // OPAQUE: accept (shouldn't reach here, but safe)
    if (mat.alphaMode < 0.5)
        return;

    // Read alpha from base color texture × baseColorFactor.a
    float alpha = mat.baseAlpha;
    int baseColorTexIdx = mat.textureIndices.x;
    if (baseColorTexIdx >= 0)
    {
        vec2 uv = anyHitUV();
        alpha *= texture(textures[nonuniformEXT(baseColorTexIdx)], uv).a;
    }

    // MASK mode: hard cutoff
    if (mat.alphaMode < 1.5)
    {
        if (alpha < mat.alphaCutoff)
            ignoreIntersectionNV();
        // else: accept (return)
        return;
    }

    // BLEND mode: Russian roulette
    uint rngState = floatBitsToUint(payload.a.w);
    float r = randomFloat(rngState);
    payload.a.w = uintBitsToFloat(rngState);

    if (r >= alpha)
        ignoreIntersectionNV();
    // else: accept (return)
}