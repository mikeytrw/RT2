#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// restir_temporal.comp — fused initial candidate generation + temporal reuse.
//
// Frame sequence: Raster G-buffer → [this pass] (history → scratch) → spatial (scratch → history) → RT shading
//
// For each pixel:
// 1. Read G-buffer (world pos, normal, roughness, material, viewZ, motion)
// 2. Generate M fresh candidates (triangle and/or environment)
// 3. Reproject current pixel using gMotion to find previous frame's pixel
// 4. Fetch history reservoir from reservoirHistory[]
// 5. Validate temporal history (normal, depth, material, sky/emissive checks)
// 6. Re-evaluate history sample at current receiver → merge into fresh reservoir
// 7. Clamp temporal M to temporalMCap, scaling weight consistently
// 8. Write combined reservoir to reservoirScratch[]
// Surface history is written by the later spatial pass, after all temporal reads finish.

#include "restir_bindings.glsl"

// ---- Reservoir + surface history bindings (temporal: history=readonly, scratch=write) ----
layout(set = 0, binding = SI_BINDING_RESERVOIR_HISTORY, std430) readonly buffer ReservoirHistoryBuffer
{
    Reservoir reservoirHistory[];
};

layout(set = 0, binding = SI_BINDING_RESERVOIR_SCRATCH, std430) buffer ReservoirScratchBuffer
{
    Reservoir reservoirScratch[];
};

layout(set = 0, binding = SI_BINDING_SURFACE_HISTORY, std430) readonly buffer SurfaceHistoryBuffer
{
    SurfaceHistory surfaceHistory[];
};

layout(local_size_x = 16, local_size_y = 16) in;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint width  = uint(camera.viewportSPP.x);
    uint height = uint(camera.viewportSPP.y);

    if (pixel.x >= int(width) || pixel.y >= int(height))
        return;

    uint pixelLinear = pixel.y * width + pixel.x;

    // Initialize empty reservoir
    Reservoir res = makeEmptyReservoir();

    // ---- Read G-buffer ----
    vec4 primHit = imageLoad(gPrimHit, pixel);
    uint matIdxPacked = uint(max(primHit.w, 0.0) + 0.5);
    bool isMiss = (matIdxPacked == 0u);

    if (isMiss)
    {
        reservoirScratch[pixelLinear] = res;
        return;
    }

    // Check emissive — skip ReSTIR for emissive surfaces
    vec3 directEmission = imageLoad(gDirectEmission, pixel).rgb;
    if (dot(directEmission, directEmission) > 0.0)
    {
        reservoirScratch[pixelLinear] = res;
        return;
    }

    uint matIdx = matIdxPacked - 1u;
    Material mat = materials[matIdx];

    vec3 worldPos = primHit.xyz;
    vec2 uv = imageLoad(gPrimUV, pixel).xy;

    // Decode normal + roughness
    vec4 nrPacked = imageLoad(gNormalRoughness, pixel);
    vec4 nrDecoded = nrdDecodeNormalRoughness(nrPacked.xyz);
    vec3 gBufferN = nrDecoded.xyz;
    float roughness = nrDecoded.w;

    vec3 wo = normalize(camera.position.xyz - worldPos);
    vec3 n = dot(gBufferN, wo) >= 0.0 ? gBufferN : -gBufferN;

    float viewZ = imageLoad(gViewZ, pixel).x;

    // Reconstruct base color + metallic
    vec3 baseColor = mat.baseColor_metallic.xyz;
    int baseColorTexIdx = mat.textureIndices.x;
    if (baseColorTexIdx >= 0)
        baseColor *= texture(textures[nonuniformEXT(baseColorTexIdx)], uv).rgb;

    float metallic = mat.baseColor_metallic.w;
    int metalRoughTexIdx = mat.extraIndices.x;
    if (metalRoughTexIdx >= 0)
    {
        vec3 mr = texture(textures[nonuniformEXT(metalRoughTexIdx)], uv).rgb;
        metallic *= mr.b;
    }

    // Skip NEE for metals / pure specular
    float diffuseWeight = (1.0 - metallic)
                        * max(baseColor.x, max(baseColor.y, baseColor.z));
    if (diffuseWeight < 1e-4)
    {
        reservoirScratch[pixelLinear] = res;
        return;
    }

    // ---- Check if any lights exist ----
    float pTri = computePTri();
    bool hasTriLights = (lightCount > 0u && totalLightArea > 0.0);
    bool hasEnv = (int(camera.envMap.x) >= 0);

    if (pTri <= 0.0 && !hasEnv)
    {
        // No lights at all
        reservoirScratch[pixelLinear] = res;
        return;
    }

    uint rngState = initRNG(pixel, camera.position.w);
    uint M = max(pc.restir.freshCandidateCount, 1u);

    // ---- Generate fresh candidates ----
    for (uint i = 0u; i < M; i++)
    {
        // M represents all proposals, including samples rejected for a zero
        // target density or proposal PDF below. Counting only accepted samples
        // biases reservoir normalization upward in sparse-light regions.
        reservoirAddCandidateCount(res, 1u);

        // Decide: triangle or environment candidate
        float rFamily = randomFloat(rngState);

        if (hasTriLights && (rFamily < pTri || !hasEnv))
        {
            // Triangle candidate
            uint lightIdx = pcg(rngState) % lightCount;
            TriangleLight light = lights[lightIdx];

            float r1 = randomFloat(rngState);
            float r2 = randomFloat(rngState);
            float sqrtR1 = sqrt(r1);
            float b1 = sqrtR1 * (1.0 - r2);
            float b2 = sqrtR1 * r2;

            // Evaluate p_hat at this candidate
            TriangleCandidateEvaluation evaluation = evalTriangleCandidate(
                worldPos, n, wo, baseColor, metallic, lightIdx, b1, b2);
            float p_hat = evaluation.targetPdf;
            if (p_hat <= 0.0) continue;

            // Proposal PDF (solid-angle): pTri * (1/lightCount) * (1/area) * dist² / LNdotL
            float propPdf = evaluation.proposalPdf;
            if (propPdf <= 0.0) continue;

            float w = p_hat / propPdf;
            reservoirStreamUpdate(res, w, SAMPLE_TRIANGLE, lightIdx, b1, b2, p_hat, rngState);
        }
        else if (hasEnv)
        {
            // Environment candidate
            EnvSample envS = sampleEnvMap(rngState);
            if (envS.pdf <= 0.0) continue;

            float NdotL = dot(n, envS.dir);
            if (NdotL <= 0.0) continue;

            vec3 brdf = evalDiffuseBRDF(wo, envS.dir, n, baseColor, metallic);
            if (dot(brdf, brdf) <= 0.0) continue;

            vec3 Le = envS.radiance;
            float p_hat = luminance(brdf * Le) * NdotL;
            if (isnan(p_hat) || isinf(p_hat) || p_hat <= 0.0) continue;

            // Proposal PDF: (1 - pTri) * envS.pdf (family selection × conditional)
            float propPdf = (1.0 - pTri) * envS.pdf;
            if (propPdf <= 0.0) continue;

            float w = p_hat / propPdf;
            reservoirStreamUpdate(res, w, SAMPLE_ENV, 0u, envS.uv.x, envS.uv.y, p_hat, rngState);
        }
    }

    bool historySelected = false;

    // ---- Temporal reuse ----
    bool temporalEnabled = (pc.restir.flags & 1u) != 0u;
    if (temporalEnabled)
    {
        // gMotion is non-jittered UV displacement. Convert to pixels and move from
        // this frame's jittered storage coordinates to the previous frame's.
        vec2 motion = imageLoad(gMotion, pixel).xy;
        vec2 motionPixels = motion * vec2(width, height);
        vec2 jitterDelta = pc.restir.jitter.xy - pc.restir.jitter.zw;
        vec2 prevPixelF = vec2(pixel) + motionPixels + jitterDelta + 0.5;

        // Check if reprojected pixel is within viewport
        if (prevPixelF.x >= 0.0 && prevPixelF.x < float(width) &&
            prevPixelF.y >= 0.0 && prevPixelF.y < float(height))
        {
            ivec2 prevPixel = ivec2(floor(prevPixelF));
            // Clamp to valid range
            prevPixel.x = max(0, min(int(width) - 1, prevPixel.x));
            prevPixel.y = max(0, min(int(height) - 1, prevPixel.y));
            uint prevLinear = prevPixel.y * width + prevPixel.x;

            Reservoir histRes = reservoirHistory[prevLinear];
            histRes = sanitizeReservoir(histRes);

            if (histRes.data0.x != SAMPLE_EMPTY)
            {
                SurfaceHistory sh = surfaceHistory[prevLinear];

                bool isSkyOrEmissive = false;
                bool histValid = validateSurfaceHistory(sh, n, viewZ, matIdx,
                                                        isSkyOrEmissive, worldPos,
                                                        pc.restir.depthThreshold,
                                                        pc.restir.normalThreshold,
                                                        pc.restir.worldPosThreshold);

                if (histValid)
                {
                    uint histAge = reservoirAge(histRes);
                    uint maxAge = max(pc.restir.maxTemporalAge, 1u);
                    if (histAge < maxAge)
                    {
                        float p_hat_current = evalTargetPdf(histRes, worldPos, n, wo,
                                                           baseColor, metallic);

                        if (p_hat_current > 0.0)
                        {
                            uint histM = reservoirM(histRes);
                            uint temporalMCap = max(pc.restir.temporalMCap, 1u);
                            uint clampedM = min(histM, temporalMCap);

                            float W_prev = reservoirW(histRes);
                            float w_merge = p_hat_current * W_prev * float(clampedM);

                            if (w_merge > 0.0 && !isnan(w_merge) && !isinf(w_merge))
                            {
                                historySelected = reservoirMerge(
                                    res, histRes, w_merge, clampedM, histAge,
                                    p_hat_current, rngState);
                            }
                        }
                    }
                }
            }
        }
    }

    // Sanitize and write
    res = sanitizeReservoir(res);

    // Age follows the selected sample. A fresh sample that remains selected
    // stays at age zero even when history participated in the merge.
    if (historySelected)
    {
        uint maxAge = max(pc.restir.maxTemporalAge, 1u);
        reservoirSetAge(res, min(reservoirAge(res) + 1u, maxAge));
    }

    reservoirScratch[pixelLinear] = res;
}
