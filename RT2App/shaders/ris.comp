#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// RIS (Resampled Importance Sampling) compute pass — Phase 1 of ReSTIR.
//
// Generates per-pixel reservoirs by sampling M candidates from the uniform
// light distribution and selecting the best via streaming RIS.
//
// p_hat (target) = unoccluded contribution in AREA MEASURE:
//   p_hat(x) = luminance(brdf * Le * NdotL * LNdotL / dist²)
//
// Source PDF (uniform over lights):
//   p(x) = 1 / (lightCount * lightArea)
//
// Candidate weight: w_i = p_hat(x_i) / p(x_i)
// Reservoir W = weightSum / (M * p_hat(y))  — used at shading time.
//
// No shadow rays in this pass. Visibility tested once in the shading pass
// (secondary_raygen.rgen → sampleNEE_RIS).
//
// IMPORTANT: No /pdfOmega in the shading estimator — W replaces 1/pdf.
// Area measure throughout. See sampleNEE_RIS in scatter_shared.glsl.

#include "shader_interface.h"

layout(local_size_x = 16, local_size_y = 16) in;

// ---- Camera UBO (set 0, binding 1) ------------------------------------------
layout(set = 0, binding = SI_BINDING_CAMERA_UBO, std140) uniform CameraData
{
    vec4 position;
    vec4 forward;
    vec4 right;
    vec4 up;
    vec4 viewportSPP;
    vec4 apertureFocal;
    vec4 envMap;
    mat4 inverseProjection;
    mat4 inverseView;
    mat4 viewToClip;
    mat4 viewToClipPrev;
    mat4 worldToView;
    mat4 worldToViewPrev;
} camera;

// ---- Material buffer (set 0, binding 2) ------------------------------------
struct Material
{
    vec4 baseColor_metallic;
    vec4 emissive_roughness;
    float ior;
    float alphaCutoff;
    float alphaMode;
    float baseAlpha;
    ivec4 textureIndices;
    ivec4 extraIndices;
};

layout(set = 0, binding = SI_BINDING_MATERIAL_BUFFER, std430) readonly buffer MaterialBuffer
{
    Material materials[];
};

// ---- Position buffer (set 0, binding 8) -------------------------------------
layout(set = 0, binding = SI_BINDING_POSITION_BUFFER, std430) readonly buffer PositionBuffer
{
    vec4 trianglePositions[];
};

// ---- Light buffer (set 0, binding 9) ---------------------------------------
struct TriangleLight
{
    vec4  emission_area;
    uvec4 ids;
};

layout(set = 0, binding = SI_BINDING_LIGHT_BUFFER, std430) readonly buffer LightBuffer
{
    uint  lightCount;
    float totalLightArea;
    uint  _lightPad0;
    uint  _lightPad1;
    TriangleLight lights[];
};

// ---- Instance transforms (set 0, binding 10) --------------------------------
layout(set = 0, binding = SI_BINDING_INSTANCE_TRANSFORMS, std430) readonly buffer InstanceTransforms
{
    mat4 instanceTransforms[];
};

// ---- Instance normal offsets (set 0, binding 5) ----------------------------
layout(set = 0, binding = SI_BINDING_INSTANCE_OFFSETS, std430) readonly buffer InstanceNormalOffsets
{
    uint normalOffsets[];
};

// ---- UV buffer (set 0, binding 7) -------------------------------------------
layout(set = 0, binding = SI_BINDING_UV_BUFFER, std430) readonly buffer UVBuffer
{
    vec4 triangleUVs[];
};

// ---- Texture array (set 0, binding 11) -------------------------------------
layout(set = 0, binding = SI_BINDING_TEXTURE_ARRAY) uniform sampler2D textures[];

// ---- Reservoir buffer (set 0, binding 14) — WRITE --------------------------
struct Reservoir
{
    uint  lightIdx;
    float b1;
    float b2;
    float weightSum;
    float targetPdf;
    uint  M;
    uint  pad0;
    uint  pad1;
};

layout(set = 0, binding = SI_BINDING_RESERVOIR_HISTORY, std430) buffer ReservoirBuffer
{
    Reservoir reservoirs[];
};

// ---- G-buffer images (set 1) -----------------------------------------------
layout(set = 1, binding = SI_BINDING_G_PRIM_HIT, rgba32f) uniform readonly image2D gPrimHit;
layout(set = 1, binding = SI_BINDING_G_PRIM_GEO_NORMAL, rgba8) uniform readonly image2D gPrimGeoNormal;
layout(set = 1, binding = SI_BINDING_G_PRIM_UV, rg16f) uniform readonly image2D gPrimUV;
layout(set = 1, binding = SI_BINDING_G_NORMAL_ROUGHNESS, rgb10_a2) uniform readonly image2D gNormalRoughness;
layout(set = 1, binding = SI_BINDING_G_ALBEDO_F0, rgba16f) uniform readonly image2D gAlbedoF0;
layout(set = 1, binding = SI_BINDING_G_DIRECT_EMISSION, rgba16f) uniform readonly image2D gDirectEmission;

// ---- Push constant: candidate count M --------------------------------------
layout(push_constant) uniform Push
{
    uint M;
} push;

// ---- Helpers ----------------------------------------------------------------

uint pcg(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint state)
{
    return float(pcg(state) >> 8u) * (1.0 / 16777216.0);
}

uint initRNG(ivec2 pixel, float frameIndex)
{
    uint rngState = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + uint(frameIndex) * 26699u;
    pcg(rngState);
    return rngState;
}

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec4 nrdDecodeNormalRoughness(vec3 p)
{
    float t = p.z * 2.0 - 1.0;
    vec4 r;
    r.x = p.x - p.y;
    r.y = p.x + p.y - 1.0;
    r.z = t < 0.0 ? -1.0 : 1.0;
    r.z *= 1.0 - abs(r.x) - abs(r.y);
    r.w = abs(t);
    r.xyz = normalize(r.xyz);
    return r;
}

// Diffuse BRDF evaluation (same as scatter_shared.glsl evalDiffuseBRDF).
// NEE/RIS only evaluates the diffuse term — specular is BSDF-sampled.
vec3 evalDiffuseBRDF(vec3 wo, vec3 wi, vec3 n,
                     vec3 baseColor, float metallic)
{
    float NdotV = max(dot(wo, n), 0.0);
    float NdotL = max(dot(wi, n), 0.0);
    if (NdotV <= 0.0 || NdotL <= 0.0) return vec3(0.0);

    vec3 F0 = mix(vec3(0.04), baseColor, metallic);
    float VdotH = max(dot(wo, normalize(wo + wi)), 0.0);
    vec3 F = F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
    float specWeight = mix(luminance(F), 1.0, metallic);
    vec3 diffuseAlbedo = baseColor * (1.0 - metallic);
    return (1.0 - specWeight) * diffuseAlbedo / 3.14159265;
}

// ---- Main -------------------------------------------------------------------

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint width  = uint(camera.viewportSPP.x);
    uint height = uint(camera.viewportSPP.y);

    if (pixel.x >= int(width) || pixel.y >= int(height))
        return;

    // Initialize reservoir as empty
    Reservoir res;
    res.lightIdx   = 0u;
    res.b1         = 0.0;
    res.b2         = 0.0;
    res.weightSum  = 0.0;
    res.targetPdf  = 0.0;
    res.M          = 0u;
    res.pad0       = 0u;
    res.pad1       = 0u;

    // Skip if no lights
    if (lightCount == 0u || totalLightArea <= 0.0)
    {
        reservoirs[pixel.y * width + pixel.x] = res;
        return;
    }

    // ---- Read G-buffer ----
    vec4 primHit = imageLoad(gPrimHit, pixel);
    uint matIdxPacked = floatBitsToUint(primHit.w);
    bool isMiss = (matIdxPacked == 0u);  // 0 = sky/miss sentinel

    if (isMiss)
    {
        reservoirs[pixel.y * width + pixel.x] = res;
        return;
    }

    // Check emissive: raster writes emissive to gDirectEmission, overrides
    // gAlbedoF0 to (1,1,1,1). Emissive surfaces don't need NEE.
    vec3 directEmission = imageLoad(gDirectEmission, pixel).rgb;
    if (dot(directEmission, directEmission) > 0.0)
    {
        reservoirs[pixel.y * width + pixel.x] = res;
        return;
    }

    uint matIdx = matIdxPacked - 1u;
    Material mat = materials[matIdx];

    vec3 worldPos = primHit.xyz;
    vec2 uv = imageLoad(gPrimUV, pixel).xy;

    // Decode normal + roughness from G-buffer
    vec4 nrPacked = imageLoad(gNormalRoughness, pixel);
    vec4 nrDecoded = nrdDecodeNormalRoughness(nrPacked.xyz);
    vec3 gBufferN = nrDecoded.xyz;
    float roughness = nrDecoded.w;

    vec3 wo = normalize(camera.position.xyz - worldPos);
    vec3 n = dot(gBufferN, wo) >= 0.0 ? gBufferN : -gBufferN;

    // Reconstruct base color + metallic (same as secondary_raygen)
    vec3 baseColor = mat.baseColor_metallic.xyz;
    int baseColorTexIdx = mat.textureIndices.x;
    if (baseColorTexIdx >= 0)
        baseColor *= texture(textures[nonuniformEXT(baseColorTexIdx)], uv).rgb;

    float metallic = mat.baseColor_metallic.w;
    int metalRoughTexIdx = mat.extraIndices.x;
    if (metalRoughTexIdx >= 0)
    {
        vec3 mr = texture(textures[nonuniformEXT(metalRoughTexIdx)], uv).rgb;
        metallic *= mr.b;
    }

    // Skip NEE for metals / pure specular (diffuse weight check — same as computeNEE)
    float diffuseWeight = (1.0 - metallic)
                        * max(baseColor.x, max(baseColor.y, baseColor.z));
    if (diffuseWeight < 1e-4)
    {
        reservoirs[pixel.y * width + pixel.x] = res;
        return;
    }

    // ---- Streaming RIS ----
    uint rngState = initRNG(pixel, camera.position.w);

    uint M = max(push.M, 1u);
    float weightSum = 0.0;
    uint  bestLightIdx = 0u;
    float bestB1 = 0.0;
    float bestB2 = 0.0;
    float bestTargetPdf = 0.0;

    for (uint i = 0u; i < M; i++)
    {
        // Sample a candidate light uniformly
        uint lightIdx = pcg(rngState) % lightCount;
        TriangleLight light = lights[lightIdx];

        // Sample barycentric coords on the triangle
        float r1 = randomFloat(rngState);
        float r2 = randomFloat(rngState);
        float sqrtR1 = sqrt(r1);
        float b0 = 1.0 - sqrtR1;
        float b1 = sqrtR1 * (1.0 - r2);
        float b2 = sqrtR1 * r2;

        // Reconstruct light triangle world positions
        uint triIdx = normalOffsets[light.ids.x] + light.ids.y;
        uint posIdx = triIdx * 3u;
        mat4 lightWorld = instanceTransforms[light.ids.x];
        vec3 lp0 = vec3(lightWorld * trianglePositions[posIdx + 0u]);
        vec3 lp1 = vec3(lightWorld * trianglePositions[posIdx + 1u]);
        vec3 lp2 = vec3(lightWorld * trianglePositions[posIdx + 2u]);

        vec3 lightPoint = b0 * lp0 + b1 * lp1 + b2 * lp2;
        vec3 lightN = normalize(cross(lp1 - lp0, lp2 - lp0));

        vec3 toLight = lightPoint - worldPos;
        float dist = length(toLight);
        vec3 L = toLight / max(dist, 1e-6);

        float NdotL = dot(n, L);
        float LNdotL = dot(lightN, -L);

        // Below-horizon or back-facing light — skip (guard)
        if (NdotL <= 0.0 || LNdotL <= 0.0)
            continue;

        // Le (emission) — flat fallback or textured
        vec3 Le = light.emission_area.xyz;
        uint emissiveTexIdx = light.ids.w;
        if (emissiveTexIdx != 0xFFFFFFFFu)
        {
            vec2 luv0 = triangleUVs[posIdx + 0u].xy;
            vec2 luv1 = triangleUVs[posIdx + 1u].xy;
            vec2 luv2 = triangleUVs[posIdx + 2u].xy;
            vec2 lightUV = b0 * luv0 + b1 * luv1 + b2 * luv2;
            Le *= texture(textures[nonuniformEXT(int(emissiveTexIdx))], lightUV).rgb;
        }
        Le *= camera.apertureFocal.w;

        // BRDF (diffuse only — NEE/RIS evaluates diffuse term)
        vec3 brdf = evalDiffuseBRDF(wo, L, n, baseColor, metallic);
        if (dot(brdf, brdf) <= 0.0)
            continue;

        // p_hat = unoccluded contribution, AREA MEASURE
        // p_hat = luminance(brdf * Le * NdotL * LNdotL / dist²)
        float geom = NdotL * LNdotL / (dist * dist);
        float p_hat = luminance(brdf * Le) * geom;

        // Guards: NaN or non-positive → skip
        if (isnan(p_hat) || p_hat <= 0.0)
            continue;

        // Source PDF (area measure): 1 / (lightCount * lightArea)
        float lightArea = light.emission_area.w;
        if (lightArea <= 0.0)
            continue;
        float sourcePdf = 1.0 / (float(lightCount) * lightArea);

        // Candidate weight
        float w = p_hat / sourcePdf;

        // Streaming RIS update
        weightSum += w;
        if (randomFloat(rngState) < (w / max(weightSum, 1e-20)))
        {
            bestLightIdx  = lightIdx;
            bestB1        = b1;
            bestB2        = b2;
            bestTargetPdf = p_hat;
        }
    }

    // Guards: all candidates rejected
    if (weightSum <= 0.0 || bestTargetPdf <= 0.0)
    {
        reservoirs[pixel.y * width + pixel.x] = res;
        return;
    }

    // Write reservoir
    res.lightIdx   = bestLightIdx;
    res.b1         = bestB1;
    res.b2         = bestB2;
    res.weightSum  = weightSum;
    res.targetPdf  = bestTargetPdf;
    res.M          = M;
    reservoirs[pixel.y * width + pixel.x] = res;
}