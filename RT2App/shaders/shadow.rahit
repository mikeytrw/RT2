#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_NV_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

#include "pathtracer_shared.glsl"

// Any-hit shader for shadow rays on alpha-blended/cutout materials.
// Accept = return (do nothing) → ray terminates, surface blocks light.
// Reject = ignoreIntersectionNV() → ray continues through.
layout(location = 2) rayPayloadInEXT float shadowVisible;

vec2 shadowAnyHitUV()
{
    uint triIdx = normalOffsets[gl_InstanceID] + uint(gl_PrimitiveID);
    uint posIdx = triIdx * 3u;

    vec3 p0 = trianglePositions[posIdx + 0u].xyz;
    vec3 p1 = trianglePositions[posIdx + 1u].xyz;
    vec3 p2 = trianglePositions[posIdx + 2u].xyz;

    vec2 uv0 = triangleUVs[posIdx + 0u].xy;
    vec2 uv1 = triangleUVs[posIdx + 1u].xy;
    vec2 uv2 = triangleUVs[posIdx + 2u].xy;

    vec3 rayDir = normalize(gl_WorldRayDirectionEXT);
    vec3 hitPoint = gl_WorldRayOriginEXT + gl_HitTEXT * rayDir;

    vec3 edge0 = p1 - p0;
    vec3 edge1 = p2 - p0;
    vec3 edge2 = hitPoint - p0;

    float d00 = dot(edge0, edge0);
    float d01 = dot(edge0, edge1);
    float d11 = dot(edge1, edge1);
    float d20 = dot(edge2, edge0);
    float d21 = dot(edge2, edge1);
    float denom = d00 * d11 - d01 * d01;

    float v = (d11 * d20 - d01 * d21) / denom;
    float w = (d00 * d21 - d01 * d20) / denom;
    float u = 1.0 - v - w;

    return u * uv0 + v * uv1 + w * uv2;
}

void main()
{
    uint matIdx = gl_InstanceCustomIndexEXT;
    Material mat = materials[matIdx];

    // OPAQUE: blocks the light (accept = return)
    if (mat.alphaMode < 0.5)
        return;

    // Read alpha from base color texture × baseColorFactor.a
    float alpha = mat.baseAlpha;
    int baseColorTexIdx = mat.textureIndices.x;
    if (baseColorTexIdx >= 0)
    {
        vec2 uv = shadowAnyHitUV();
        alpha *= texture(textures[nonuniformEXT(baseColorTexIdx)], uv).a;
    }

    // MASK mode: hard cutoff
    if (mat.alphaMode < 1.5)
    {
        if (alpha < mat.alphaCutoff)
            ignoreIntersectionNV();  // transparent → ray continues
        // else: accept (return) → blocks light
        return;
    }

    // BLEND mode: Russian roulette — probabilistic occlusion
    // No payload rngState available (shadow payload is just a float),
    // so use a hash from instance/primitive IDs.
    uint hash = gl_InstanceID * 1973u + gl_PrimitiveID * 9277u;
    hash = hash * 747796405u + 2891336453u;
    hash = ((hash >> ((hash >> 28u) + 4u)) ^ hash) * 277803737u;
    hash = (hash >> 22u) ^ hash;
    float r = float(hash) / 4294967295.0;

    if (r >= alpha)
        ignoreIntersectionNV();  // passes through
    // else: accept (return) → probabilistic occluder
}