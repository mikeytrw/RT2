#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// scatter_shared.glsl includes pathtracer_shared.glsl + scatter/NEE functions
#include "scatter_shared.glsl"

layout(location = 0) rayPayloadEXT RayPayload payload;
layout(location = 1) rayPayloadEXT RayPayload nextPayload;

// G-buffer images (set 1) — written by raster pass, read here
// Declared in pathtracer_shared.glsl:
//   gNormalRoughness (rgb10_a2), gViewZ (r32f), gMotion (rg16f),
//   gDiffRadianceHitDist (rgba16f), gSpecRadianceHitDist (rgba16f),
//   gAlbedoF0 (rgba16f), gDirectEmission (rgba16f)
// Additional G-buffer images (raster-only, set 1):
layout(set = 1, binding = SI_BINDING_G_PRIM_HIT, rgba32f) uniform readonly image2D gPrimHit;
layout(set = 1, binding = SI_BINDING_G_PRIM_GEO_NORMAL, rgba8) uniform readonly image2D gPrimGeoNormal;
layout(set = 1, binding = SI_BINDING_G_PRIM_UV, rg16f) uniform readonly image2D gPrimUV;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    uint width  = uint(camera.viewportSPP.x);
    uint height = uint(camera.viewportSPP.y);
    uint spp    = uint(camera.viewportSPP.z);

    if (pixel.x >= int(width) || pixel.y >= int(height))
        return;

    bool nrdMode = (nrdData.nrdEnabled != 0u);
    if (nrdMode)
        spp = 1u; // NRD expects 1 spp

    // ---- Read G-buffer (primary hit data from raster pass) ----
    vec4 primHit = imageLoad(gPrimHit, pixel);
    uint matIdxPacked = uint(max(primHit.w, 0.0) + 0.5);
    bool isMiss = (matIdxPacked == 0u);  // 0 = miss/sky sentinel

    // Initialize RNG from pixel coords + frame index
    uint rngState = initRNG(pixel, camera.position.w);

    // ---- Handle primary miss (sky) ----
    if (isMiss)
    {
        // Trace a ray to get sky/env radiance (miss shader handles it)
        vec3 origin = camera.position.xyz;
        float u = (float(pixel.x) + 0.5 + camera.forward.w) / float(width);
        float v = (float(pixel.y) + 0.5 + camera.right.w) / float(height);
        vec2 coord = vec2(u, v) * 2.0 - 1.0;
        vec4 target = camera.inverseProjection * vec4(coord.x, coord.y, 1.0, 1.0);
        vec3 dir = normalize(vec3(camera.inverseView * vec4(normalize(vec3(target) / target.w), 0.0)));

        payload.a = vec4(vec3(1.0), uintBitsToFloat(rngState));
        payload.b = vec4(vec3(0.0), 0);
        payload.c = vec4(origin, 0.0);
        payload.d = vec4(dir, -1.0);
        payload.e = vec4(0.0);

        traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0,
                    origin, 0.001, dir, 1e9, 0);

        vec3 skyRadiance = payload.b.xyz;

        if (nrdMode)
        {
            writeNRDSkyDefaults(pixel, skyRadiance);
        }
        else
        {
            vec3 color = temporalAccumulate(pixel, skyRadiance, camera.position.w);
            imageStore(outputImage, pixel, vec4(color, 1.0));
        }
        return;
    }

    // ---- Primary hit from G-buffer ----
    uint matIdx = matIdxPacked - 1u;  // unpack sentinel
    Material mat = materials[matIdx];

    vec3 worldPos = primHit.xyz;
    vec2 uv = imageLoad(gPrimUV, pixel).xy;

    // Normal from G-buffer: NRD oct-packed (encoding=2, SQRT_LINEAR)
    vec4 nrPacked = imageLoad(gNormalRoughness, pixel);
    vec4 nrDecoded = nrdDecodeNormalRoughness(nrPacked.xyz);
    vec3 gBufferN = nrDecoded.xyz;
    float roughness = nrDecoded.w;

    // View direction (towards camera)
    vec3 wo = normalize(camera.position.xyz - worldPos);

    // Face-forward flip: raster FS doesn't flip normal to face camera.
    // RT closesthit does: n = frontFace ? normal : -normal
    vec3 n = dot(gBufferN, wo) >= 0.0 ? gBufferN : -gBufferN;
    float NdotV = max(dot(n, wo), 0.0);

    // Geometric normal (for ray offset)
    vec3 geoN = normalize(imageLoad(gPrimGeoNormal, pixel).xyz * 2.0 - 1.0);

    // View-space Z
    float viewZ = imageLoad(gViewZ, pixel).x;

    // Albedo + metallic (for NRD material factor computation)
    vec4 albedoF0 = imageLoad(gAlbedoF0, pixel);
    vec3 albedo = albedoF0.rgb;
    float metallic = albedoF0.a;

    // Compute NRD material factors for demodulation
    vec3 Rf0 = mix(vec3(0.04), albedo, metallic);
    vec3 diffFactor, specFactor;
    nrdMaterialFactors(n, wo, albedo, Rf0, roughness, diffFactor, specFactor);

    // Direct emission (from raster pass)
    vec3 directEmission = imageLoad(gDirectEmission, pixel).rgb;

    // Check if emissive (raster pass writes emissive to gDirectEmission and
    // overrides gAlbedoF0 to (1,1,1,1) for emissive pixels)
    bool isEmissive = dot(directEmission, directEmission) > 0.0;

    // ---- Emissive: terminate (parity with closesthit early-return) ----
    if (isEmissive)
    {
        if (nrdMode)
        {
            // G-buffer already written by raster pass (emissive overrides).
            // Just write beauty output.
            imageStore(gDiffRadianceHitDist, pixel, vec4(0.0));
            imageStore(gSpecRadianceHitDist, pixel, vec4(0.0));
            imageStore(outputImage, pixel, vec4(directEmission, 1.0));
        }
        else
        {
            vec3 color = temporalAccumulate(pixel, directEmission, camera.position.w);
            imageStore(outputImage, pixel, vec4(color, 1.0));
        }
        return;
    }

    // ---- Reconstruct primary-hit state for scatter ----
    // Sample textures for base color / metallic (normal already from G-buffer).
    // Roughness is ALREADY textured in gNormalRoughness.w (raster.frag bakes it),
    // so do NOT re-sample metallicRoughness for roughness — that would square it.
    vec3 baseColor = mat.baseColor_metallic.xyz;
    int baseColorTexIdx = mat.textureIndices.x;
    if (baseColorTexIdx >= 0)
        baseColor *= texture(textures[nonuniformEXT(baseColorTexIdx)], uv).rgb;

    // Metallic: use the textured value from gAlbedoF0 (baked by raster.frag).
    // Do NOT re-sample the metallicRoughness texture — that would double-apply.
    // (metallic was already loaded from albedoF0.a at line 108)

    float ior = mat.ior;

    // frontFace: ray came from camera towards surface.
    // Raster pass renders the closest surface; n is flipped to face camera above.
    bool frontFace = true;

    // ---- Scatter: stochastic lobe selection (same as closesthit) ----
    vec3 rayDir = -wo;  // incoming ray direction
    ScatterResult scatter = scatterPrimaryHit(
        mat, baseColor, metallic, roughness, ior,
        n, wo, NdotV, rayDir, frontFace, rngState,
        uvec2(pixel.xy), int(nrdData.lobeDither));

    // ---- Check termination conditions ----
    uint maxBounces = uint(camera.viewportSPP.w);
    if (!scatter.doScatter)
    {
        // Invalid scatter direction — absorb
        if (nrdMode)
        {
            imageStore(gDiffRadianceHitDist, pixel, vec4(0.0));
            imageStore(gSpecRadianceHitDist, pixel, vec4(0.0));
            imageStore(outputImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        }
        else
        {
            imageStore(outputImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        }
        return;
    }

    // ---- NEE: direct lighting ----
    bool useReSTIR = (camera.up.w > 0.5);
    uint pixelLinear = uint(pixel.y) * width + uint(pixel.x);
    NEEDispatchResult nee = computeNEE(
        scatter, wo, n, worldPos,
        baseColor, metallic, roughness, ior, mat.alphaMode,
        vec3(1.0), rngState, useReSTIR, pixelLinear);

    vec3 directLighting = nee.radiance;
    float nextBsdfPdf = nee.nextBsdfPdf;

    // ---- Trace secondary ray (depth=1, closesthit handles bounces) ----
    // Offset along the face-forward shading normal (n), not geoN — geoN from
    // raster derivatives can point into the surface depending on triangle winding.
    vec3 offsetN = dot(scatter.scatterDir, n) > 0.0 ? n : -n;
    vec3 rayOrigin = worldPos + offsetN * 0.001;

    // Write scatter data to payload (location 0) — the trace uses location 0.
    // nextPayload (location 1) is only used by closesthit for recursive traces;
    // here we trace directly from raygen, so payload (location 0) is the one.
    payload.a = vec4(scatter.attenuation, uintBitsToFloat(rngState));  // throughput * attenuation, rngState bit-cast
    payload.b = vec4(vec3(0.0), 1.0);                  // radiance = 0, depth = 1
    payload.c = vec4(rayOrigin, 0.0);
    payload.d = vec4(normalize(scatter.scatterDir), nextBsdfPdf);
    // Carry the selected primary lobe to the miss shader. ReSTIR replaces only
    // diffuse direct lighting; rough-specular environment transport must remain.
    payload.e = vec4(scatter.lobeType, 0.0, 0.0, 0.0);

    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0,
                rayOrigin, 0.001, payload.d.xyz, 1e9, 0);

    // Total radiance = direct lighting (NEE) + indirect (secondary ray)
    vec3 indirectRad = payload.b.xyz;
    vec3 totalRad = directLighting + indirectRad;
    rngState = floatBitsToUint(payload.a.w);

    // hitT for NRD = secondary ray hit distance only (NOT primary, per NRD docs)
    // closesthit stores gl_HitTEXT in payload.e.w at depth=1
    float secondaryHitT = payload.e.w;
    // Fallback for missed rays (hitT=0): use a large value so NRD treats it as far hit
    if (secondaryHitT <= 0.0)
        secondaryHitT = 1e4;

    // ---- NRD output ----
    if (nrdMode)
    {
        // NEE is diffuse-only (evalDiffuseBRDF in NEE only evaluates the
        // diffuse term). It must always go to the diffuse NRD signal,
        // NOT be routed by lobe type. Only the indirect radiance from
        // the secondary ray follows the selected lobe.
        vec3 diffNee = directLighting;
        vec3 diffIndirect = vec3(0.0);
        vec3 specIndirect = vec3(0.0);
        float diffHitT = secondaryHitT;
        float specHitT = secondaryHitT;

        if (scatter.lobeType < 0.5)
        {
            // Diffuse lobe: indirect goes to diffuse
            diffIndirect = indirectRad;
        }
        else
        {
            // Specular lobe: indirect goes to specular
            specIndirect = indirectRad;
        }

        vec3 diffRad = diffNee + diffIndirect;

        // Clear stale per-lobe history inputs before independently writing the
        // signals produced this frame. A specular continuation can coexist
        // with diffuse ReSTIR direct lighting at the same primary pixel.
        imageStore(gDiffRadianceHitDist, pixel, vec4(0.0));
        imageStore(gSpecRadianceHitDist, pixel, vec4(0.0));

        if (dot(diffRad, diffRad) > 0.0)
            writeNRDDiffuse(pixel, diffRad, diffFactor, diffHitT, viewZ);

        if (dot(specIndirect, specIndirect) > 0.0)
            writeNRDSpecular(pixel, specIndirect, specFactor, specHitT, viewZ, roughness);

        vec3 beautyRad = diffRad + specIndirect;
        imageStore(gDirectEmission, pixel, vec4(0.0));
        imageStore(outputImage, pixel, vec4(beautyRad, 1.0));
    }
    else
    {
        vec3 color = temporalAccumulate(pixel, totalRad, camera.position.w);
        imageStore(outputImage, pixel, vec4(color, 1.0));
    }
}
