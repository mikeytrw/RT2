#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

// restir_spatial.comp — spatial neighbor reuse pass.
//
// Frame sequence: ... → [this pass] (scratch → history) → RT shading
//
// For each pixel:
// 1. Read center reservoir from reservoirScratch[]
// 2. Read G-buffer for current receiver (normal, depth, material)
// 3. For each neighbor (frame-rotated disk pattern):
//    a. Read neighbor reservoir from reservoirScratch[]
//    b. Validate neighbor using current-frame normal, depth, material
//    c. Re-evaluate neighbor's selected sample at the center receiver
//    d. Merge using canonical ReSTIR weight with source-M cap
// 4. Write final result and current surface metadata for the next frame
//
// Neighbor selection: frame-rotated disk pattern, not fixed square kernel.
// One pass only (avoids needing a third reservoir buffer).

#include "restir_bindings.glsl"

// ---- Reservoir bindings (spatial: scratch=readonly, history=write) ----
layout(set = 0, binding = SI_BINDING_RESERVOIR_SCRATCH, std430) readonly buffer ReservoirScratchReadBuffer
{
    Reservoir reservoirScratch[];
};

layout(set = 0, binding = SI_BINDING_RESERVOIR_HISTORY, std430) buffer ReservoirHistoryWriteBuffer
{
    Reservoir reservoirHistory[];
};

layout(set = 0, binding = SI_BINDING_SURFACE_HISTORY, std430) buffer SurfaceHistoryWriteBuffer
{
    SurfaceHistory surfaceHistory[];
};

layout(local_size_x = 16, local_size_y = 16) in;

// Frame-rotated disk pattern offsets (golden-angle rotation per frame).
// Uses a fixed set of neighbor offsets, rotated by frame index.
vec2 rotateOffset(vec2 offset, uint frameIndex)
{
    float angle = float(frameIndex) * 2.39996323;  // golden angle
    float ca = cos(angle);
    float sa = sin(angle);
    return vec2(offset.x * ca - offset.y * sa,
                offset.x * sa + offset.y * ca);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint width  = uint(camera.viewportSPP.x);
    uint height = uint(camera.viewportSPP.y);

    if (pixel.x >= int(width) || pixel.y >= int(height))
        return;

    uint pixelLinear = pixel.y * width + pixel.x;

    // ---- Read G-buffer for center pixel ----
    vec4 primHit = imageLoad(gPrimHit, pixel);
    uint matIdxPacked = floatBitsToUint(primHit.w);
    bool isMiss = (matIdxPacked == 0u);

    if (isMiss)
    {
        reservoirHistory[pixelLinear] = makeEmptyReservoir();
        surfaceHistory[pixelLinear] = makeSurfaceHistory(vec3(0.0, 0.0, 1.0), 1e6, 0xFFFFFFFFu, false, vec3(0.0));
        return;
    }

    vec3 directEmission = imageLoad(gDirectEmission, pixel).rgb;
    if (dot(directEmission, directEmission) > 0.0)
    {
        reservoirHistory[pixelLinear] = makeEmptyReservoir();
        surfaceHistory[pixelLinear] = makeSurfaceHistory(vec3(0.0, 0.0, 1.0), 1e6, 0xFFFFFFFFu, false, vec3(0.0));
        return;
    }

    uint matIdx = matIdxPacked - 1u;
    Material mat = materials[matIdx];

    vec3 worldPos = primHit.xyz;
    vec2 uv = imageLoad(gPrimUV, pixel).xy;

    vec4 nrPacked = imageLoad(gNormalRoughness, pixel);
    vec4 nrDecoded = nrdDecodeNormalRoughness(nrPacked.xyz);
    vec3 gBufferN = nrDecoded.xyz;
    float roughness = nrDecoded.w;

    vec3 wo = normalize(camera.position.xyz - worldPos);
    vec3 n = dot(gBufferN, wo) >= 0.0 ? gBufferN : -gBufferN;

    float viewZ = imageLoad(gViewZ, pixel).x;

    // Reconstruct base color + metallic
    vec3 baseColor = mat.baseColor_metallic.xyz;
    int baseColorTexIdx = mat.textureIndices.x;
    if (baseColorTexIdx >= 0)
        baseColor *= texture(textures[nonuniformEXT(baseColorTexIdx)], uv).rgb;

    float metallic = mat.baseColor_metallic.w;
    int metalRoughTexIdx = mat.extraIndices.x;
    if (metalRoughTexIdx >= 0)
    {
        vec3 mr = texture(textures[nonuniformEXT(metalRoughTexIdx)], uv).rgb;
        metallic *= mr.b;
    }

    float diffuseWeight = (1.0 - metallic)
                        * max(baseColor.x, max(baseColor.y, baseColor.z));
    if (diffuseWeight < 1e-4)
    {
        reservoirHistory[pixelLinear] = makeEmptyReservoir();
        surfaceHistory[pixelLinear] = makeSurfaceHistory(n, viewZ, matIdx, false, worldPos);
        return;
    }

    // ---- Read center reservoir ----
    Reservoir centerRes = reservoirScratch[pixelLinear];
    centerRes = sanitizeReservoir(centerRes);

    bool spatialEnabled = (pc.restir.flags & 2u) != 0u;
    if (!spatialEnabled || centerRes.data0.x == SAMPLE_EMPTY)
    {
        reservoirHistory[pixelLinear] = centerRes;
        surfaceHistory[pixelLinear] = makeSurfaceHistory(n, viewZ, matIdx, true, worldPos);
        return;
    }

    // ---- Spatial neighbor reuse with canonical merge + source-M cap ----
    // Each valid neighbor is merged using the canonical ReSTIR merge weight:
    //   w_j = p_hat_center(x_j) * W_j * M_j_capped
    // The source M is capped by spatialMCap to prevent correlated reservoirs
    // from inflating effective M without bound across frames.
    // Pairwise MIS is NOT implemented — the p_hat_center is used only as a
    // validity check, not in a denominator.
    uint neighborCount = max(pc.restir.spatialNeighborCount, 1u);
    uint radius = max(pc.restir.spatialRadius, 1u);
    uint frameIndex = pc.restir.frameIndex;

    uint rngState = initRNG(pixel, camera.position.w + 7777.0);

    // Generate neighbor offsets using frame-rotated disk pattern
    // Use golden-angle spiral for quasi-random distribution
    vec2 neighborOffsets[32];  // max 32 neighbors
    uint actualNeighbors = min(neighborCount, 32u);
    for (uint i = 0u; i < actualNeighbors; i++)
    {
        float goldenAngle = 2.39996323;
        float r = sqrt(float(i + 1u) / float(actualNeighbors)) * float(radius);
        float theta = float(i) * goldenAngle + float(frameIndex) * 0.1;
        vec2 offset = vec2(cos(theta), sin(theta)) * r;
        neighborOffsets[i] = rotateOffset(offset, frameIndex);
    }

    // First pass: compute p_hat for center and all valid neighbors
    float p_hat_center = evalTargetPdf(centerRes, worldPos, n, wo, baseColor, metallic);
    if (p_hat_center <= 0.0)
    {
        // Center sample is invalid at its own receiver — start fresh
        centerRes = makeEmptyReservoir();
    }

    // Accumulate p_hat for each valid neighbor
    float neighborPHats[32];
    bool neighborValid[32];

    for (uint i = 0u; i < actualNeighbors; i++)
    {
        neighborPHats[i] = 0.0;
        neighborValid[i] = false;

        ivec2 nPixel = pixel + ivec2(neighborOffsets[i]);
        if (nPixel.x < 0 || nPixel.x >= int(width) ||
            nPixel.y < 0 || nPixel.y >= int(height))
            continue;

        uint nLinear = nPixel.y * width + nPixel.x;

        // Validate neighbor: check normal, depth, material
        vec4 nPrimHit = imageLoad(gPrimHit, nPixel);
        uint nMatIdxPacked = floatBitsToUint(nPrimHit.w);
        if (nMatIdxPacked == 0u) continue;  // sky

        vec3 nDirectEmission = imageLoad(gDirectEmission, nPixel).rgb;
        if (dot(nDirectEmission, nDirectEmission) > 0.0) continue;  // emissive

        uint nMatIdx = nMatIdxPacked - 1u;
        if (nMatIdx != matIdx) continue;

        vec4 nNrPacked = imageLoad(gNormalRoughness, nPixel);
        vec4 nNrDecoded = nrdDecodeNormalRoughness(nNrPacked.xyz);
        vec3 nNormal = nNrDecoded.xyz;
        vec3 nWo = normalize(camera.position.xyz - nPrimHit.xyz);
        vec3 nFaceForward = dot(nNormal, nWo) >= 0.0 ? nNormal : -nNormal;

        if (dot(nFaceForward, n) < pc.restir.normalThreshold) continue;

        float nViewZ = imageLoad(gViewZ, nPixel).x;
        float depthDiff = abs(nViewZ - viewZ) / max(abs(viewZ), 1e-6);
        if (depthDiff > pc.restir.depthThreshold) continue;

        // Neighbor is valid — re-evaluate its sample at the center receiver
        Reservoir nRes = reservoirScratch[nLinear];
        nRes = sanitizeReservoir(nRes);
        if (nRes.data0.x == SAMPLE_EMPTY) continue;

        float p_hat_at_center = evalTargetPdf(nRes, worldPos, n, wo, baseColor, metallic);
        if (p_hat_at_center <= 0.0) continue;

        neighborPHats[i] = p_hat_at_center;
        neighborValid[i] = true;
    }

    // Second pass: merge valid neighbors with canonical ReSTIR weights
    uint spatialMCap = max(pc.restir.spatialMCap, 1u);
    for (uint i = 0u; i < actualNeighbors; i++)
    {
        if (!neighborValid[i]) continue;

        ivec2 nPixel = pixel + ivec2(neighborOffsets[i]);
        uint nLinear = nPixel.y * width + nPixel.x;
        Reservoir nRes = reservoirScratch[nLinear];
        nRes = sanitizeReservoir(nRes);

        float p_hat_at_center = neighborPHats[i];

        float W_neighbor = reservoirW(nRes);
        uint M_neighbor = reservoirM(nRes);
        uint clampedM = min(M_neighbor, spatialMCap);

        float w_merge = p_hat_at_center * W_neighbor * float(clampedM);

        if (w_merge > 0.0 && !isnan(w_merge) && !isinf(w_merge))
        {
            reservoirMerge(centerRes, nRes, w_merge, clampedM,
                           p_hat_at_center, rngState);
        }
    }

    // Sanitize and write to history
    centerRes = sanitizeReservoir(centerRes);
    reservoirHistory[pixelLinear] = centerRes;
    surfaceHistory[pixelLinear] = makeSurfaceHistory(n, viewZ, matIdx, true, worldPos);
}
