#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D linearInput;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D displayOutput;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(linearInput);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec3 linearColor = max(imageLoad(linearInput, pixel).rgb, vec3(0.0));
    vec3 mapped = linearColor / (vec3(1.0) + linearColor);
    imageStore(displayOutput, pixel, vec4(mapped, 1.0));
}
