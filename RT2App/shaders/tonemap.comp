#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D linearInput;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D displayOutput;

#include "tonemap_shared.glsl"

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(linearInput);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec4 hdr = imageLoad(linearInput, pixel);
    if (isnan(hdr.r) || isnan(hdr.g) || isnan(hdr.b) ||
        isinf(hdr.r) || isinf(hdr.g) || isinf(hdr.b))
    {
        // Deterministic safe display value; checked PNG capture detects the
        // scene-linear sample on the CPU and fails rather than succeeding.
        imageStore(displayOutput, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    // Diagnostic views bypass the camera look; the host also resolves the
    // legacy constants, so either side alone preserves the mapping.
    int toneOperator = pc.toneOperator;
    float exposureMultiplier = pc.exposureMultiplier;
    if (pc.legacyDiagnostic != 0)
    {
        toneOperator = 2;
        exposureMultiplier = 1.0;
    }

    vec3 exposed = max(hdr.rgb, vec3(0.0)) * exposureMultiplier;
    vec3 mapped = tonemapDisplay(exposed, toneOperator);
    float alpha = (isnan(hdr.a) || isinf(hdr.a)) ? 1.0 : clamp(hdr.a, 0.0, 1.0);
    imageStore(displayOutput, pixel, vec4(linearToSRGB(mapped), alpha));
}
