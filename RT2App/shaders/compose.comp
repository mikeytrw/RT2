#version 460
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D outputImage;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D nrdDiffOut;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D nrdSpecOut;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D gAlbedoF0;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D gDirectEmission;
layout(set = 0, binding = 5, r32f)   uniform readonly image2D gViewZ;
layout(set = 0, binding = 6, rgb10_a2) uniform readonly image2D gNormalRoughness;

// Camera UBO (for view direction reconstruction)
#include "shader_interface.h"
layout(set = 0, binding = 7, std140) uniform CameraData
{
    vec4 position;
    vec4 forward;
    vec4 right;
    vec4 up;
    vec4 viewportSPP;
    vec4 apertureFocal;
    vec4 envMap;
    mat4 inverseProjection;
    mat4 inverseView;
    mat4 viewToClip;
    mat4 viewToClipPrev;
    mat4 worldToView;
    mat4 worldToViewPrev;
} camera;

// NRD REBLUR outputs are encoded in YCoCg color space, not linear RGB.
vec3 YCoCgToLinear(vec3 ycocg)
{
    float t = ycocg.x - ycocg.z;
    vec3 linear;
    linear.y = ycocg.x + ycocg.z;
    linear.x = t + ycocg.y;
    linear.z = t - ycocg.y;
    return max(linear, vec3(0.0));
}

// NRD oct normal/roughness decode (matches NRD_NORMAL_ENCODING=2, NRD_ROUGHNESS_ENCODING=1)
vec4 nrdDecodeNormalRoughness(vec3 p)
{
    float t = p.z * 2.0 - 1.0;
    vec4 r;
    r.x = p.x - p.y;
    r.y = p.x + p.y - 1.0;
    r.z = t < 0.0 ? -1.0 : 1.0;
    r.z *= 1.0 - abs(r.x) - abs(r.y);
    r.w = abs(t);
    r.xyz = normalize(r.xyz);
    // NRD_ROUGHNESS_ENCODING=1 stores linear roughness directly. The exact
    // same value must be used for front-end demodulation and back-end
    // remodulation (NRD.hlsli: NRD_MaterialFactors contract).
    r.w = clamp(r.w, 0.0, 1.0);
    return r;
}

// NRD environment term (Ray Tracing Gems Ch32, Eq 4)
vec3 nrdEnvironmentTerm(vec3 Rf0, float NoV, float roughness)
{
    float m = clamp(roughness * roughness, 0.0, 1.0);
    vec4 X = vec4(1.0, NoV, NoV * NoV, NoV * NoV * NoV);
    vec4 Y = vec4(1.0, m, m * m, m * m * m);
    mat2 M1 = mat2(0.99044, -1.28514, 1.29678, -0.755907);
    mat3 M2 = mat3(1.0, 2.92338, 59.4188, 20.3225, -27.0302, 222.592, 121.563, 626.13, 316.627);
    mat2 M3 = mat2(0.0365463, 3.32707, 9.0632, -9.04756);
    mat3 M4 = mat3(1.0, 3.59685, -1.36772, 9.04401, -16.3174, 9.22949, 5.56589, 19.7886, -20.2123);
    vec2 M1X = M1 * X.xy;
    vec3 M2X = M2 * vec3(X.xyw);
    float bias = dot(M1X, Y.xy) / max(dot(M2X, Y.xyw), 1e-6);
    vec2 M3X = M3 * X.xy;
    vec3 M4X = M4 * vec3(X.xzw);
    float scale = dot(M3X, Y.xy) / max(dot(M4X, Y.xyw), 1e-6);
    return clamp(Rf0 * scale + vec3(bias), 0.0, 1.0);
}

#define NRD_MATERIAL_FACTOR_MIN_SCALE 0.01
#define NRD_ROUGHNESS_FACTOR_MIN_SCALE 0.1

void nrdMaterialFactors(vec3 N, vec3 V, vec3 albedo, vec3 Rf0, float roughness,
                       out vec3 diffFactor, out vec3 specFactor)
{
    float NoV = abs(dot(N, V));
    vec3 Fenv = nrdEnvironmentTerm(Rf0, NoV, roughness);
    diffFactor = (1.0 - Fenv) * albedo;
    diffFactor = mix(vec3(NRD_MATERIAL_FACTOR_MIN_SCALE), vec3(1.0), diffFactor);
    specFactor = Fenv * mix(vec3(NRD_ROUGHNESS_FACTOR_MIN_SCALE), vec3(1.0), roughness);
    specFactor = mix(vec3(NRD_MATERIAL_FACTOR_MIN_SCALE), vec3(1.0), specFactor);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec4 albedoF0 = imageLoad(gAlbedoF0, pixel);
    vec3 albedo = albedoF0.rgb;
    float metallic = albedoF0.a;

    // Direct emission (emissive surfaces + sky — bypasses NRD)
    vec3 directEmission = imageLoad(gDirectEmission, pixel).rgb;

    // Sky pixels: viewZ > denoisingRange (500000). NRD skips these pixels but
    // may leave stale data in its output images from previous frames when the
    // pixel was geometry. Skip NRD contribution entirely for sky pixels.
    float viewZ = imageLoad(gViewZ, pixel).x;
    bool isSky = abs(viewZ) > 500000.0;

    vec3 finalColor;
    if (isSky)
    {
        finalColor = directEmission;
    }
    else
    {
        // NRD outputs are in YCoCg — convert to linear before remodulation
        vec3 diffDenoised = YCoCgToLinear(imageLoad(nrdDiffOut, pixel).rgb);
        vec3 specDenoised = YCoCgToLinear(imageLoad(nrdSpecOut, pixel).rgb);

        // Reconstruct N, V, roughness for material factors
        vec3 nrPacked = imageLoad(gNormalRoughness, pixel).xyz;
        vec4 nrDecoded = nrdDecodeNormalRoughness(nrPacked);
        vec3 N = nrDecoded.xyz;
        float roughness = nrDecoded.w;

        // Reconstruct view direction V from camera position and pixel.
        // V = normalize(cameraPos - worldPos). We don't have worldPos, but we
        // can compute it from viewZ and the inverse projection.
        // In view space: surface = (viewX, viewY, viewZ). Camera is at origin.
        // V_view = normalize(-surface_view). Transform to world: V = inverseView * V_view.
        // Use non-jittered NDC: jitter changes every frame, introducing per-frame
        // variation in the reconstructed V → per-frame variation in remodulated
        // specular output → flickering, especially on camera move.
        vec2 ndc = (vec2(pixel.xy) + 0.5) / vec2(size) * 2.0 - 1.0;
        vec4 viewRay = camera.inverseProjection * vec4(ndc, 1.0, 1.0);
        vec3 viewDir = normalize(vec3(viewRay) / viewRay.w);
        // The surface in view space is at viewDir * |viewZ| (viewZ is negative for camera looking -Z)
        vec3 surfaceView = viewDir * abs(viewZ);
        vec3 Vview = normalize(-surfaceView);
        vec3 V = normalize(vec3(camera.inverseView * vec4(Vview, 0.0)));

        float NoV = abs(dot(N, V));

        vec3 Rf0 = mix(vec3(0.04), albedo, metallic);
        vec3 diffFactor, specFactor;
        nrdMaterialFactors(N, V, albedo, Rf0, roughness, diffFactor, specFactor);

        // Remodulate: multiply denoised demodulated radiance back by material factors
        vec3 diffRemod = diffDenoised * diffFactor;
        vec3 specRemod = specDenoised * specFactor;

        finalColor = diffRemod + specRemod + directEmission;
    }

    imageStore(outputImage, pixel, vec4(finalColor, 1.0));
}
