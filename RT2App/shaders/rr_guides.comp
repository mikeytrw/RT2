#version 460
#extension GL_EXT_scalar_block_layout : require
#include "shader_interface.h"
#include "rr_guide_shared.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = SI_BINDING_CAMERA_UBO, std140) uniform CameraData
{ vec4 position; vec4 forward; vec4 right; vec4 up; vec4 viewportSPP; vec4 apertureFocal;
  vec4 envMap; mat4 inverseProjection; mat4 inverseView; mat4 viewToClip; mat4 viewToClipPrev;
  mat4 worldToView; mat4 worldToViewPrev; } camera;
layout(set = 1, binding = SI_BINDING_G_NORMAL_ROUGHNESS, rgb10_a2) uniform readonly image2D gNormalRoughness;
layout(set = 1, binding = SI_BINDING_G_ALBEDO_F0, rgba16f) uniform readonly image2D gAlbedoF0;
layout(set = 1, binding = SI_BINDING_G_PRIM_HIT, rgba32f) uniform readonly image2D gPrimHit;
layout(set = 1, binding = 12, r11f_g11f_b10f) uniform image2D rrNoisyHdr;
layout(set = 1, binding = 13, rgba8) uniform image2D rrDiffuseAlbedo;
layout(set = 1, binding = 14, rgba8) uniform image2D rrSpecularAlbedo;
layout(set = 1, binding = 15, rgba16f) uniform image2D rrNormalRoughness;

vec4 decodeNR(vec3 p)
{
    float t = p.z * 2.0 - 1.0;
    vec2 xy = vec2(p.x - p.y, p.x + p.y - 1.0);
    float z = (t < 0.0 ? -1.0 : 1.0) * (1.0 - abs(xy.x) - abs(xy.y));
    return vec4(normalize(vec3(xy, z)), clamp(abs(t), 0.0, 1.0));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrDiffuseAlbedo);
    if (p.x >= size.x || p.y >= size.y) return;
    vec4 albedoF0 = imageLoad(gAlbedoF0, p);
    vec4 nr = decodeNR(imageLoad(gNormalRoughness, p).xyz);
    vec4 hit = imageLoad(gPrimHit, p);
    bool miss = hit.w < 0.5;
    vec3 diffuse = miss ? vec3(0.0) : clamp(albedoF0.rgb, 0.0, 1.0);
    vec3 specular = miss ? vec3(0.5) : EnvBRDFApprox2(
        mix(vec3(0.04), clamp(albedoF0.rgb, 0.0, 1.0), clamp(albedoF0.a, 0.0, 1.0)),
        nr.w, 1.0);
    vec3 normal = miss ? vec3(0.0, 1.0, 0.0) : normalize(nr.xyz);
    float roughness = miss ? 1.0 : nr.w;
    imageStore(rrDiffuseAlbedo, p, vec4(diffuse, 1.0));
    imageStore(rrSpecularAlbedo, p, vec4(clamp(specular, 0.0, 1.0), 1.0));
    imageStore(rrNormalRoughness, p, vec4(normal, roughness));
}
