#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

#include "pathtracer_shared.glsl"

layout(location = 0) rayPayloadEXT RayPayload payload;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    uint width  = uint(camera.viewportSPP.x);
    uint height = uint(camera.viewportSPP.y);
    uint spp    = uint(camera.viewportSPP.z);

    if (pixel.x >= int(width) || pixel.y >= int(height))
        return;

    bool nrdMode = (nrdData.nrdEnabled != 0u);
    if (nrdMode)
        spp = 1u; // NRD expects 1 spp

    // Initialize RNG from pixel coords + frame index
    uint rngState = pixel.x * 1973u + pixel.y * 9277u + uint(camera.position.w) * 26699u;
    pcg(rngState); // warm up

    vec3 origin = camera.position.xyz;

    // Trace spp rays per pixel and average
    vec3 color = vec3(0.0);
    vec3 diffRad = vec3(0.0);  // NRD: diffuse radiance accumulator
    vec3 specRad = vec3(0.0);  // NRD: specular radiance accumulator
    vec3 directEmission = vec3(0.0); // NRD: emissive/miss radiance (bypasses NRD)
    float diffHitT = 0.0;
    float specHitT = 0.0;

    for (uint s = 0u; s < spp; s++)
    {
        // Depth-of-field: jitter ray origin within aperture
        vec3 defocusJitter = vec3(0.0);
        if (camera.apertureFocal.x > 0.0)
        {
            vec2 diskPoint = sampleUnitDisk(rngState) * camera.apertureFocal.x;
            defocusJitter = camera.right.xyz * diskPoint.x + camera.up.xyz * diskPoint.y;
        }

        float u = (float(pixel.x) + randomFloat(rngState) + camera.forward.w) / float(width);
        float v = (float(pixel.y) + randomFloat(rngState) + camera.right.w) / float(height);
        vec2 coord = vec2(u, v) * 2.0 - 1.0;
        vec4 target = camera.inverseProjection * vec4(coord.x, coord.y, 1.0, 1.0);
        vec3 dir = normalize(vec3(camera.inverseView * vec4(normalize(vec3(target) / target.w), 0.0)));

        // Depth of field: adjust focus
        vec3 rayOrigin = origin;
        if (camera.apertureFocal.x > 0.0)
        {
            vec3 focalPoint = rayOrigin + dir * camera.apertureFocal.y;
            rayOrigin += defocusJitter;
            dir = normalize(focalPoint - rayOrigin);
        }

        // Initialize payload for recursive path tracing
        // d.w = bsdfPdf (solid-angle): -1.0 = camera ray (delta, full emission),
        // >= 0 = diffuse bounce (MIS-weighted emission).
        // e = NRD primary-hit info, filled by closesthit at depth 0;
        //     e.w == 0 after the trace means the primary ray missed (or hit an
        //     emitter, which returns before the G-buffer capture).
        payload.a = vec4(vec3(1.0), uintBitsToFloat(rngState));   // throughput = 1, rngState in .w (bit-cast to preserve uint bits)
        payload.b = vec4(vec3(0.0), 0);           // radiance = 0, depth = 0
        payload.c = vec4(rayOrigin, 0.0);          // ray origin, done = 0
        payload.d = vec4(dir, -1.0);              // ray dir, bsdfPdf = -1 (camera)
        payload.e = vec4(0.0);

        traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0,
                    rayOrigin, 0.001, dir, 1e9, 0);

        color += payload.b.xyz;
        rngState = floatBitsToUint(payload.a.w);

        if (nrdMode)
        {
            // Route radiance based on primary hit lobe type:
            // 0 = diffuse, 1 = specular, 2 = emissive (bypass NRD)
            // For emissive: lobeType is in payload.e.z (set by closesthit)
            // For normal: lobeType is packed in payload.e.x's w component
            float lobeType;
            if (payload.e.z > 1.5)
                lobeType = 2.0; // emissive
            else
                lobeType = unpackUnorm4x8(floatBitsToUint(payload.e.x)).w;

            if (lobeType > 1.5 || payload.e.w == 0.0)
            {
                // Emissive or primary miss — direct emission, bypasses NRD
                directEmission += payload.b.xyz;
            }
            else if (lobeType < 0.5)
            {
                diffRad += payload.b.xyz;
                diffHitT = payload.e.w;
            }
            else
            {
                specRad += payload.b.xyz;
                specHitT = payload.e.w;
            }
        }
    }
    color /= float(spp);

    if (nrdMode)
    {
        // Primary miss: write sky defaults (NRD skips viewZ >= denoisingRange)
        if (payload.e.w == 0.0 && payload.e.z <= 1.5)
        {
            imageStore(gNormalRoughness, pixel, vec4(0.5, 0.5, 1.0, 1.0));
            imageStore(gViewZ, pixel, vec4(1e6, 0.0, 0.0, 0.0));
            imageStore(gAlbedoF0, pixel, vec4(1.0, 1.0, 1.0, 1.0));
        }

        // Write direct emission (emissive surfaces + sky/miss)
        imageStore(gDirectEmission, pixel, vec4(directEmission, 0.0));

        // Zero NRD inputs for emissive/miss pixels (no noisy signal to denoise)
        bool isEmissiveOrMiss = (payload.e.w == 0.0) || (payload.e.z > 1.5);
        if (isEmissiveOrMiss)
        {
            imageStore(gDiffRadianceHitDist, pixel, vec4(0.0));
            imageStore(gSpecRadianceHitDist, pixel, vec4(0.0));
            imageStore(gMotion, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        }
        else
        {
            // Demodulate: divide radiance by material factors returned in payload.e
            vec4 albedoLobe = unpackUnorm4x8(floatBitsToUint(payload.e.x));
            vec2 f0rough = unpackUnorm2x16(floatBitsToUint(payload.e.y));
            vec3 diffFactor = max(albedoLobe.xyz, vec3(0.01));
            float specFactor = max(f0rough.x, 0.01);
            float viewZ = payload.e.z;
            float roughness = f0rough.y;

            vec3 demodDiff = diffRad / diffFactor;
            vec3 demodSpec = specRad / vec3(specFactor);

            // Clamp fireflies: NRD's anti-firefly works better when extreme
            // outliers are clamped. The sun disk in env maps can produce
            // radiance values >10000 which NRD can't handle during reprojection.
            const float NRD_CLAMP = 100.0;
            demodDiff = clamp(demodDiff, vec3(0.0), vec3(NRD_CLAMP));
            demodSpec = clamp(demodSpec, vec3(0.0), vec3(NRD_CLAMP));

            // NRD hit distance normalization
            vec3 hitDistParams = vec3(3.0, 0.1, 20.0);
            float normDiffHitT = nrdGetNormHitDist(diffHitT, viewZ, hitDistParams, 1.0);
            float normSpecHitT = nrdGetNormHitDist(specHitT, viewZ, hitDistParams, roughness);

            // NRD expects radiance in YCoCg color space
            vec3 diffYCoCg = linearToYCoCg(demodDiff);
            vec3 specYCoCg = linearToYCoCg(demodSpec);

            imageStore(gMotion, pixel, vec4(0.0, 0.0, 0.0, 0.0));
            imageStore(gDiffRadianceHitDist, pixel, vec4(diffYCoCg, normDiffHitT));
            imageStore(gSpecRadianceHitDist, pixel, vec4(specYCoCg, normSpecHitT));
        }

        // Write beauty output as the sum (compose pass will overwrite with denoised)
        imageStore(outputImage, pixel, vec4(color, 1.0));
        return;
    }

    // Temporal accumulation: blend with previous frame
    float frameIndex = camera.position.w;
    if (frameIndex > 1.0)
    {
        vec3 prevColor = imageLoad(outputImage, pixel).xyz;
        color = (prevColor * (frameIndex - 1.0) + color) / frameIndex;
    }

    imageStore(outputImage, pixel, vec4(color, 1.0));
}