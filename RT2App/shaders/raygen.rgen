#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require

#include "pathtracer_shared.glsl"

layout(location = 0) rayPayloadEXT RayPayload payload;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    uint width  = uint(camera.viewportSPP.x);
    uint height = uint(camera.viewportSPP.y);

    if (pixel.x >= int(width) || pixel.y >= int(height))
        return;

    // DEBUG SHADER #1: Display textures[0] stretched across the screen.
    // Proves GPU texture upload + bindless descriptor array works.
    vec2 uv = vec2(float(pixel.x) / float(width), 1.0 - float(float(pixel.y) / float(height)));
    vec3 color = texture(textures[0], uv).rgb;

    imageStore(outputImage, pixel, vec4(color, 1.0));
}