# Directories
.vs/
bin/
bin-int/

# Files
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.sln

# Exclude
!vendor/binimgui.ini

# Temp / generated files
imgui.ini
rt2_log.txt
regression_current.png
test_*.png

# Phase 7 per-asset identity sidecars (D8). In a real project these are
# committed alongside the asset (identity travels with it). In this repo's
# test/fixture trees they are regenerated on every import, so ignore them
# there to avoid churn; a project that wants committed identity overrides
# this with a path-scoped `!` rule.
*.rt2meta

# Renderer captures, benchmark output, logs, and Python caches are local-only.
/artifacts/
/baselines/
/benchmarking/*.png
*.pfm
*.exr
# Checked-in tiny fixture environment maps are source, not captures.
!RT2App/assets/phase1a-fixtures/*.exr
*.log
*.dmp
scripts/__pycache__/
.pytest_cache/

# Incremental graph exports are generated metadata, not source.
graphify-out/2026-*/

# Research PDFs are local-only reference material, not tracked.
*.pdf
/research/

# Graphify cache
graphify-out/cache/

# Graphify machine-readable output. Regenerated in full by `graphify update .`
# (AST-only, ~1-2 min, no API cost), so tracking it buys nothing and costs a
# lot: graph.json alone is ~42MB rewritten on every refresh, and 13 revisions
# of it dominated a 407MB .git.
#
# GRAPH_REPORT.md is deliberately NOT ignored — it is human-readable, useful
# on a fresh clone, and small enough to diff.
#
# Note: `graphify query` needs graph.json, so a fresh clone must run
# `graphify update .` once before querying. See AGENTS.md.
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/.graphify_labels.json
